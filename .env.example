# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Este archivo es solo un EJEMPLO (se sube a git, sin datos reales).
# Las reales van en .env.local (tu computadora, ignorado por git) y en Vercel → Settings → Environment Variables.
#
# Regla: las variables SIN el prefijo NEXT_PUBLIC_ solo las lee el servidor; las que lo llevan viajan al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Personas del equipo (JSON en una sola línea). En tu computadora no hace falta: se lee data/private/team.json.
# En Vercel sí: pegar ahí el contenido de ese archivo. Solo se publica a quien tenga "consent": true.
# Para generar la línea:  Get-Content data\private\team.json -Raw | ConvertFrom-Json | ConvertTo-Json -Depth 10 -Compress | Set-Clipboard
TEAM_DATA=

# Solo en TU .env.local: pon 1 para ver a todos (aunque no tengan permiso) mientras pruebas el diseño.
# En Vercel NO la definas: así el sitio publicado muestra únicamente a quien dio su permiso.
TEAM_SHOW_ALL=

# Dirección pública del sitio (para la imagen al compartir). Solo si el sitio pasa a un dominio propio.
NEXT_PUBLIC_SITE_URL=
